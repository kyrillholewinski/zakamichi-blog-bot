# Copy this file to .env and fill in your values:
#   cp .env.example .env
# .env is gitignored; never commit real tokens or keys.

# --- Polling ---------------------------------------------------------------

# Cycle interval in SECONDS, despite the name (default 900 = 15 minutes).
POLLING_INTERVAL_MS=900

# Session cookie for the Bokuao blog (copy the Cookie header from a logged-in browser).
BOKUAO_COOKIE=

# --- Translation (Gemini) --------------------------------------------------

# API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Models are tried in order; if one errors or returns no translation, the next is used.
# MODEL_1 is required, MODEL_2 and MODEL_3 are optional fallbacks.
GEMINI_API_MODEL_1=gemini-2.5-pro
GEMINI_API_MODEL_2=gemini-2.5-flash
GEMINI_API_MODEL_3=gemini-2.5-flash-lite

# true enables the overnight backfill (00:00-07:59 JST) that translates archived
# HTML from blogContent/ into blogContent_TC/, newest first.
ENABLE_TRANSLATION=false

# Starting daily backfill limit (default 50). Resets at 00:00 UTC. Once
# record/admin-state.json exists, the limit stored there is used instead;
# change it from the admin panel.
DAILY_TRANSLATION_QUOTA=50

# --- Telegram broadcasting -------------------------------------------------

# false turns off all Telegram broadcasting (default on).
# Channels, bot tokens and per-group settings live in config/config.json.
ENABLE_BROADCAST=true

# Path to the broadcast config (default config/config.json).
CONFIG_FILE_NAME=config/config.json

# --- Admin panel (optional) ------------------------------------------------
# Leave either empty to disable the panel.

# Token of the bot that serves /admin (from @BotFather). It can be one of your
# broadcast bots, as long as no webhook is set on it.
ADMIN_BOT_TOKEN=

# Your numeric Telegram user id (e.g. from @userinfobot). The panel only answers
# this account, and only in a private chat with the bot.
OWNER_USER_ID=
